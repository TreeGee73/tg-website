---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="What I Can Do | Theresa Grier">
  <article class="what-i-can-do-page">
    <!-- Hero Section with Hexagon Headshot -->
    <section class="hero-section">
      <div class="hero-content">
        <div class="hero-image">
          <img
            src="/images/headshot.png"
            alt="Theresa Grier - IT Professional"
            class="hexagon-frame"
          />
        </div>
        <div class="hero-text">
          <h1>What I Can Do</h1>
          <p class="intro">
            20+ years leading IT operations, managing projects, and building
            secure systems — across startups, nonprofits, and my own company.
            Backed by hands-on technical expertise and a growing collection of
            industry certifications.
          </p>
        </div>
      </div>
    </section>

    <div class="content-wrapper">
      <!-- Certifications Section -->
      <section class="certifications">
        <h2>Certifications & Education</h2>
        <p class="certs-intro">
          Currently pursuing additional industry certifications through my WGU
          degree program, including CompTIA Network+, Security+, and more.
        </p>
        <div class="cert-grid">
          <!-- Cybersecurity Degree (in progress) - CURRENT -->
          <div class="cert-card in-progress">
            <div class="cert-icon">🎓</div>
            <h3>B.S. Cybersecurity & Information Assurance</h3>
            <p>Western Governors University</p>
            <p class="cert-details">In Progress • Expected 2026</p>
          </div>

          <!-- CompTIA A+ (2024) - RECENT -->
          <a
            href="https://www.credly.com/badges/4d738f02-3e5f-450e-ae38-9972b409197c"
            target="_blank"
            rel="noopener noreferrer"
            class="cert-card"
          >
            <div class="cert-badge-image">
              <img
                src="/badges/comptia-a-plus.png"
                alt="CompTIA A+ Certification Badge"
              />
            </div>
            <h3>CompTIA A+</h3>
            <p class="cert-details">Earned 2024</p>
            <span class="verify-link">View Credential →</span>
          </a>

          <!-- Full-Stack Web Development (2021) - FOUNDATION -->
          <a
            href="https://www.credly.com/badges/your-fswd-badge-id"
            target="_blank"
            rel="noopener noreferrer"
            class="cert-card"
          >
            <div class="cert-badge-image">
              <img
                src="/badges/full-stack-web-development.png"
                alt="Full-Stack Web Development Certificate Badge"
              />
            </div>
            <h3>Full-Stack Web Development</h3>
            <p>University of Arizona</p>
            <p class="cert-details">Completed 2021</p>
            <span class="verify-link">View Credential →</span>
          </a>

          <!-- Future Certification Goals - COMMENTED OUT -->
          <!-- 
                    <div class="cert-card placeholder">
                        <div class="cert-icon">🎯</div>
                        <h3>Next Certification Goals</h3>
                        <p>CompTIA Network+</p>
                        <p>CompTIA Security+</p>
                        <p class="cert-details">Target: 2025</p>
                    </div>
                    -->
        </div>
      </section>

      <!-- Skills Section -->
      <section class="skills">
        <h2>Technical Skills</h2>

        <div class="skill-category">
          <h3>🏆 Leadership & Management</h3>
          <div class="skill-tags">
            <span class="skill-tag">IT Operations Leadership</span>
            <span class="skill-tag">Project Management</span>
            <span class="skill-tag">Team Leadership</span>
            <span class="skill-tag">Vendor Management</span>
            <span class="skill-tag">Stakeholder Communication</span>
            <span class="skill-tag">Business Continuity Planning</span>
            <span class="skill-tag">Process Improvement</span>
            <span class="skill-tag">Technical Training</span>
          </div>
        </div>

        <div class="skill-category">
          <h3>💻 Development</h3>
          <div class="skill-tags">
            <span class="skill-tag">HTML/CSS</span>
            <span class="skill-tag">JavaScript</span>
            <span class="skill-tag">React</span>
            <span class="skill-tag">Node.js</span>
            <span class="skill-tag">Express</span>
            <span class="skill-tag">MySQL</span>
            <span class="skill-tag">MongoDB</span>
            <span class="skill-tag">Git/GitHub</span>
          </div>
        </div>

        <div class="skill-category">
          <h3>🛠️ Tools & Platforms</h3>
          <div class="skill-tags">
            <span class="skill-tag">Microsoft 365</span>
            <span class="skill-tag">Azure</span>
            <span class="skill-tag">Active Directory</span>
            <span class="skill-tag">Google Workspace</span>
            <span class="skill-tag">Slack</span>
            <span class="skill-tag">Asana</span>
          </div>
        </div>

        <div class="skill-category">
          <h3>🔒 Cybersecurity & IT</h3>
          <div class="skill-tags">
            <span class="skill-tag">Network Security</span>
            <span class="skill-tag">System Administration</span>
            <span class="skill-tag">Incident Response</span>
            <span class="skill-tag">Vulnerability Assessment</span>
            <span class="skill-tag">Access Control</span>
            <span class="skill-tag">IT Infrastructure</span>
            <span class="skill-tag">Hardware Troubleshooting</span>
          </div>
        </div>
      </section>

      <!-- Professional Experience Section -->
      <section class="experience">
        <h2>Professional Experience</h2>

        <p class="experience-intro">
          20+ years of IT leadership across entrepreneurship, startups, and
          nonprofits — directing operations, managing teams and vendors, and
          building the technical infrastructure organizations depend on.
        </p>

        <div class="experience-item">
          <div class="experience-header">
            <h3>Co-Founder & Operations Lead</h3>
            <span class="company">GeeCubed, LLC</span>
            <span class="dates">2021–Present</span>
          </div>
          <p class="experience-description">
            Co-founded a technical services company specializing in IT solutions
            and engineering. Lead all IT operations including web development,
            technical consulting, and digital infrastructure management for
            small business clients. Handle business operations, client
            relationships, and service delivery while maintaining hands-on
            technical work.
          </p>
        </div>

        <div class="experience-item">
          <div class="experience-header">
            <h3>Director of IT & Security</h3>
            <span class="company">Wallace MacDonald</span>
            <span class="dates">2025</span>
          </div>
          <p class="experience-description">
            Led enterprise-wide IT and security operations across multiple sites
            for a green energy startup. Directed infrastructure modernization,
            cybersecurity governance, vendor management, and ERP integration.
            Architected access control policies, incident response procedures,
            and vulnerability management programs — while conducting security
            audits and staff security awareness training.
          </p>
        </div>

        <div class="experience-item">
          <div class="experience-header">
            <h3>IT Manager</h3>
            <span class="company">League of Historic American Theatres</span>
            <span class="dates">2013–2024</span>
          </div>
          <p class="experience-description">
            Managed all technical operations for a national nonprofit
            organization. Directed website operations, database management,
            email migrations, mobile app development, and user training. Served
            as the technical backbone for the organization, coordinating vendors
            and ensuring seamless day-to-day IT operations.
          </p>
        </div>

        <div class="linkedin-cta">
          <p>
            For my complete professional history, recommendations, and detailed
            accomplishments:
          </p>
          <a
            href="https://www.linkedin.com/in/theresa-grier/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-linkedin"
          >
            View Full Profile on LinkedIn
          </a>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .what-i-can-do-page {
    background-color: #fafafa;
  }

  /* Hero Section with Hexagon Headshot */
  .hero-section {
    background: linear-gradient(135deg, #364a60 0%, #00438f 100%);
    padding: 4rem 2rem;
  }

  .hero-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .hero-image {
    flex-shrink: 0;
  }

  /* HEXAGON TECH FRAME STYLING */
  .hero-image img.hexagon-frame {
    width: 350px;
    height: 350px;
    object-fit: cover;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    transition: all 0.4s ease;
  }

  .hero-image img.hexagon-frame:hover {
    transform: scale(1.05) rotate(2deg);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5);
  }

  .hero-text {
    flex: 1;
    color: white;
  }

  .hero-text h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .intro {
    font-size: 1.3rem;
    line-height: 1.8;
    opacity: 0.95;
  }

  /* Content Wrapper */
  .content-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  /* Section Headers */
  h2 {
    font-size: 2rem;
    color: #364a60;
    margin-bottom: 2rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #00438f;
  }

  /* Certifications Section */
  .certifications {
    margin-bottom: 5rem;
  }

  .certs-intro {
    font-size: 1.1rem;
    line-height: 1.7;
    color: #545454;
    margin-bottom: 2rem;
    max-width: 800px;
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .cert-card {
    background: white;
    border: 2px solid #e5e5e5;
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s;
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .cert-card:hover {
    border-color: #00438f;
    transform: translateY(-4px);
    box-shadow: 0 4px 12px rgba(0, 67, 143, 0.2);
  }

  .cert-card.placeholder {
    border-style: dashed;
    opacity: 0.7;
  }

  .cert-card.in-progress {
    border-color: #00438f;
    background: linear-gradient(135deg, #e1c9c8 0%, #ffffff 100%);
  }

  .cert-badge-image {
    margin-bottom: 1rem;
    width: 200px;
    height: 200px;
    margin-left: auto;
    margin-right: auto;
  }

  .cert-badge-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cert-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .cert-card h3 {
    font-size: 1.3rem;
    color: #00438f;
    margin-bottom: 0.5rem;
  }

  .cert-card p {
    color: #545454;
    margin-bottom: 0.5rem;
  }

  .cert-details {
    font-size: 0.9rem;
    color: #808080;
  }

  .verify-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.9rem;
    color: #00438f;
    font-weight: 600;
  }

  a.cert-card:hover .verify-link {
    text-decoration: underline;
  }

  /* Skills Section */
  .skills {
    margin-bottom: 5rem;
  }

  .skill-category {
    margin-bottom: 2.5rem;
  }

  .skill-category h3 {
    font-size: 1.5rem;
    color: #00438f;
    margin-bottom: 1rem;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skill-tag {
    background: white;
    color: #00438f;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.95rem;
    border: 2px solid #00438f;
  }

  /* Professional Experience Section */
  .experience {
    margin-bottom: 3rem;
  }

  .experience-intro {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #545454;
    margin-bottom: 1.5rem;
  }

  .linkedin-cta {
    margin-top: 3rem;
    padding: 3rem 2rem;
    background: linear-gradient(135deg, #e1c9c8 0%, #aeaeae 20%, #e1c9c8 100%);
    border-radius: 12px;
    text-align: center;
  }

  .linkedin-cta p {
    font-size: 1.2rem;
    color: #364a60;
    margin-bottom: 2rem;
    font-weight: 500;
  }

  .btn-linkedin {
    display: inline-block;
    padding: 1rem 2.5rem;
    background-color: #00438f;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1.1rem;
    transition: all 0.3s ease;
  }

  .btn-linkedin:hover {
    background-color: #003366;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 67, 143, 0.3);
  }

  .experience-item {
    background: white;
    padding: 2rem;
    border-radius: 12px;
    margin-bottom: 2rem;
    border-left: 4px solid #00438f;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .experience-header {
    margin-bottom: 1rem;
  }

  .experience-header h3 {
    font-size: 1.5rem;
    color: #364a60;
    margin-bottom: 0.25rem;
  }

  .company {
    font-size: 1.1rem;
    color: #00438f;
    font-weight: 500;
    margin-right: 1rem;
  }

  .dates {
    font-size: 1rem;
    color: #808080;
    font-style: italic;
  }

  .experience-description {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #545454;
  }

  /* Responsive Design */
  @media (max-width: 968px) {
    .hero-content {
      flex-direction: column;
      text-align: center;
    }

    .hero-image img.hexagon-frame {
      width: 300px;
      height: 300px;
    }

    .hero-text h1 {
      font-size: 2.5rem;
    }

    .intro {
      font-size: 1.1rem;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 3rem 1.5rem;
    }

    .hero-image img.hexagon-frame {
      width: 250px;
      height: 250px;
    }

    .hero-text h1 {
      font-size: 2rem;
    }

    .cert-grid {
      grid-template-columns: 1fr;
    }

    h2 {
      font-size: 1.6rem;
    }
  }
</style>
