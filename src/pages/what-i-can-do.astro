---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="What I Can Do" pageClass="what-i-can-do-page">
  <article class="skills-content">
    <h1>What I Can Do</h1>

    <div class="intro-section">
      <p class="lead">
        Combining cybersecurity expertise with full-stack development skills to
        build secure, functional solutions.
      </p>
    </div>

    <section class="certifications">
      <h2>Certifications & Education</h2>
      <p class="certs-intro">
        Currently pursuing additional industry certifications through my WGU
        degree program, including CompTIA Network+, Security+, and more.
      </p>
      <div class="cert-grid">
        <!-- Cybersecurity Degree (in progress) - CURRENT -->
        <div class="cert-card in-progress">
          <div class="cert-icon">🎓</div>
          <h3>B.S. Cybersecurity & Information Assurance</h3>
          <p>In Progress | Western Governors University</p>
          <p class="cert-details">Expected completion: 2026</p>
        </div>

        <!-- CompTIA A+ Certification - RECENT -->
        <a
          href="https://www.credly.com/badges/4d738f02-3e5f-450e-ae38-9972b409197c"
          target="_blank"
          rel="noopener noreferrer"
          class="cert-card"
        >
          <div class="cert-badge-image">
            <img
              src="/badges/comptia-a-plus.png"
              alt="CompTIA A+ Certification"
            />
          </div>
          <h3>CompTIA A+</h3>
          <p>Certified | 2024</p>
          <p class="cert-details">Core IT infrastructure and troubleshooting</p>
          <span class="verify-link">Click to verify →</span>
        </a>

        <!-- Full-Stack Web Development - FOUNDATION -->
        <a
          href="https://www.credly.com/earner/earned/badge/6114da00-cc24-4d4d-9549-032aab8adb92"
          target="_blank"
          rel="noopener noreferrer"
          class="cert-card"
        >
          <div class="cert-badge-image">
            <img
              src="/badges/full-stack-web-development.png"
              alt="Full-Stack Web Development Certification"
            />
          </div>
          <h3>Full-Stack Web Development</h3>
          <p>Certified | 2021</p>
          <p class="cert-details">
            JavaScript, React, Node.js, databases, modern frameworks
          </p>
          <span class="verify-link">Click to verify →</span>
        </a>

        <!-- Future Certification Placeholder -->
        <!-- <div class="cert-card placeholder">
          <div class="cert-icon">🔒</div>
          <h3>Security+ / CISSP</h3>
          <p>Next certification goals</p>
          <p class="cert-details">
            Building toward advanced security credentials
          </p>
        </div> -->
      </div>
    </section>

    <section class="skills">
      <h2>Technical Skills</h2>

      <div class="skill-category">
        <h3>Cybersecurity & Infrastructure Security</h3>
        <ul class="skill-list">
          <li>Cybersecurity Implementation</li>
          <li>Cybersecurity Governance</li>
          <li>Infrastructure Security</li>
          <li>Application Security</li>
          <li>Security Protocols</li>
          <li>Risk Assessment</li>
          <li>Incident Response</li>
          <li>SSL/TLS</li>
          <li>Network Configuration</li>
          <li>Business Continuity Planning</li>
        </ul>
      </div>

      <div class="skill-category">
        <h3>IT Infrastructure & Systems</h3>
        <ul class="skill-list">
          <li>IT Infrastructure Management</li>
          <li>System Administration</li>
          <li>System Configuration</li>
          <li>Cloud Computing</li>
          <li>Virtualization</li>
          <li>Backup and Recovery</li>
          <li>Computer Network Management</li>
          <li>Mobile Device Management (MDM)</li>
          <li>Operating Systems (Linux, macOS, Windows)</li>
          <li>Technical Support</li>
          <li>Help Desk Support</li>
          <li>Troubleshooting</li>
        </ul>
      </div>

      <div class="skill-category">
        <h3>Development & Programming</h3>
        <ul class="skill-list">
          <li>JavaScript</li>
          <li>React.js</li>
          <li>Node.js</li>
          <li>HTML/CSS</li>
          <li>RESTful APIs</li>
          <li>jQuery</li>
          <li>JSON</li>
          <li>Agile Software Development</li>
          <li>Git</li>
          <li>GitHub</li>
        </ul>
      </div>

      <div class="skill-category">
        <h3>Databases & Backend</h3>
        <ul class="skill-list">
          <li>Database Management</li>
          <li>Database Development</li>
          <li>MongoDB</li>
          <li>MySQL</li>
        </ul>
      </div>

      <div class="skill-category">
        <h3>Web & Application Technologies</h3>
        <ul class="skill-list">
          <li>Web Development</li>
          <li>Web Design</li>
          <li>Mobile Application Development</li>
          <li>CMS Administration</li>
          <li>Content Delivery</li>
          <li>Heroku</li>
        </ul>
      </div>

      <div class="skill-category">
        <h3>Project Management & Operations</h3>
        <ul class="skill-list">
          <li>Technical Project Management</li>
          <li>Program Management</li>
          <li>Project Governance</li>
          <li>Strategic Planning</li>
          <li>Process Optimization</li>
          <li>Business Process Improvement</li>
          <li>Operations Management</li>
          <li>Vendor Management</li>
          <li>Technical Documentation</li>
        </ul>
      </div>

      <div class="skill-category">
        <h3>Leadership & Collaboration</h3>
        <ul class="skill-list">
          <li>Team Leadership</li>
          <li>Stakeholder Management</li>
          <li>Cross-functional Collaboration</li>
          <li>Strategic Partnerships</li>
          <li>Quality Assurance</li>
          <li>Data Analysis</li>
        </ul>
      </div>
    </section>

    <section class="experience-highlight">
      <h2>Professional Experience</h2>
      <p class="experience-intro">
        My career in technology has been hands-on and multifaceted. At the
        League of Historic American Theatres, I managed all technical
        operations—web redesign, email migrations, mobile app development, and
        daily content management. It was a role that required resourcefulness
        and the ability to deliver results across a broad technical landscape.
      </p>
      <p class="experience-intro">
        As Director of Information Technology at Wallace MacDonald, my focus
        expanded from building systems to securing them. I managed
        infrastructure, implemented security protocols, and protected
        proprietary technology for a green energy startup—work that deepened my
        commitment to cybersecurity and revealed where I wanted to take my
        career.
      </p>

      <div class="linkedin-cta">
        <p>
          For my complete professional history, recommendations, and detailed
          accomplishments:
        </p>
        <a
          href="https://www.linkedin.com/in/theresa-grier/"
          target="_blank"
          class="btn-linkedin"
        >
          View Full Profile on LinkedIn
        </a>
      </div>
    </section>

    <div class="cta-section">
      <p>Want to see my work in action?</p>
      <a href="/portfolio" class="btn-primary">View My Portfolio</a>
    </div>
  </article>
</BaseLayout>

<style>
  .what-i-can-do-page {
    /* Page-specific body class */
  }

  .skills-content {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  h1 {
    font-size: 2.5rem;
    color: #1a1a1a;
    margin-bottom: 2rem;
    text-align: center;
  }

  .intro-section {
    margin-bottom: 3rem;
    padding: 2rem;
    background-color: #f0f7ff; /* Cool professional background */
    border-radius: 12px;
    border-left: 4px solid #0066cc; /* Professional blue accent */
    text-align: center;
  }

  .lead {
    font-size: 1.25rem;
    line-height: 1.8;
    color: #555;
    margin: 0;
  }

  /* Certifications Section */
  .certs-intro {
    font-size: 1.05rem;
    color: #666;
    margin-bottom: 1.5rem;
    font-style: italic;
  }

  .certifications {
    margin-bottom: 4rem;
  }

  .certifications h2 {
    font-size: 2rem;
    color: #333;
    margin-bottom: 2rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #0066cc;
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .cert-card {
    background: white;
    border: 2px solid #e5e5e5;
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s;
  }

  .cert-card:hover {
    border-color: #0066cc;
    transform: translateY(-4px);
    box-shadow: 0 4px 12px rgba(0, 102, 204, 0.1);
  }

  .cert-card.placeholder {
    border-style: dashed;
    opacity: 0.7;
  }

  .cert-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .cert-card h3 {
    font-size: 1.3rem;
    color: #0066cc;
    margin-bottom: 0.5rem;
  }

  .cert-card p {
    color: #666;
    margin-bottom: 0.5rem;
  }

  .cert-details {
    font-size: 0.9rem;
    color: #999;
  }

  /* Badge Image */
  .cert-badge-image {
    margin-bottom: 1rem;
    width: 200px;
    height: 200px;
    margin-left: auto;
    margin-right: auto;
  }

  .cert-badge-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Skills Section */
  .skills {
    margin-bottom: 4rem;
  }

  .skills h2 {
    font-size: 2rem;
    color: #333;
    margin-bottom: 2rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #0066cc;
  }

  .skill-category {
    margin-bottom: 2rem;
    padding: 1.5rem;
    background-color: #f8f9fa;
    border-radius: 8px;
  }

  .skill-category h3 {
    font-size: 1.3rem;
    color: #0066cc;
    margin-bottom: 1rem;
  }

  .skill-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
    list-style: none;
  }

  .skill-list li {
    padding: 0.5rem 1rem;
    background-color: white;
    border-radius: 6px;
    color: #555;
    font-weight: 500;
    border-left: 3px solid #0066cc;
  }

  /* Experience Section */
  .experience-highlight {
    margin-bottom: 3rem;
  }

  .experience-highlight h2 {
    font-size: 2rem;
    color: #333;
    margin-bottom: 2rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #0066cc;
  }

  .experience-intro {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #555;
    margin-bottom: 2rem;
  }

  .linkedin-cta {
    text-align: center;
    padding: 2rem;
    background-color: #f0f7ff;
    border-radius: 12px;
  }

  .linkedin-cta p {
    font-size: 1.1rem;
    color: #666;
    margin-bottom: 1rem;
  }

  .btn-linkedin {
    display: inline-block;
    padding: 1rem 2rem;
    background-color: #0077b5; /* LinkedIn blue */
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: all 0.3s;
  }

  .btn-linkedin:hover {
    background-color: #006399;
    transform: translateY(-2px);
  }

  /* CTA Section */
  .cta-section {
    text-align: center;
    padding: 3rem 2rem;
    background-color: #f8f9fa;
    border-radius: 12px;
  }

  .cta-section p {
    font-size: 1.2rem;
    color: #666;
    margin-bottom: 1.5rem;
  }

  .btn-primary {
    display: inline-block;
    padding: 1rem 2rem;
    background-color: #0066cc;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: all 0.3s;
  }

  .btn-primary:hover {
    background-color: #0052a3;
    transform: translateY(-2px);
  }
</style>
