---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="What I Can Do" pageClass="what-i-can-do-page">
    <article class="skills-content">
        <h1>What I Can Do</h1>
        
        <div class="intro-section">
            <p class="lead">
                Combining cybersecurity expertise with full-stack development skills 
                to build secure, functional solutions.
            </p>
        </div>

        <section class="certifications">
            <h2>Certifications & Education</h2>
            <div class="cert-grid">
                <div class="cert-card">
                    <div class="cert-icon">🎓</div>
                    <h3>Cybersecurity Degree</h3>
                    <p>Currently pursuing | [University Name]</p>
                    <p class="cert-details">Expected completion: [Date]</p>
                </div>

                <div class="cert-card">
                    <div class="cert-icon">💻</div>
                    <h3>Full-Stack Web Development</h3>
                    <p>Bootcamp Graduate | [Year]</p>
                    <p class="cert-details">JavaScript, React, Node.js, databases</p>
                </div>

                <!-- Add more certification cards as you earn them -->
                <div class="cert-card placeholder">
                    <div class="cert-icon">🔒</div>
                    <h3>Future Certifications</h3>
                    <p>CompTIA Security+, CISSP, or others you're pursuing</p>
                </div>
            </div>
        </section>

        <section class="skills">
            <h2>Technical Skills</h2>
            
            <div class="skill-category">
                <h3>Cybersecurity</h3>
                <ul class="skill-list">
                    <li>Network Security</li>
                    <li>Threat Analysis</li>
                    <li>Security Auditing</li>
                    <li>Vulnerability Assessment</li>
                    <!-- Add your specific security skills -->
                </ul>
            </div>

            <div class="skill-category">
                <h3>Development</h3>
                <ul class="skill-list">
                    <li>JavaScript / TypeScript</li>
                    <li>React / Astro</li>
                    <li>HTML / CSS</li>
                    <li>Node.js</li>
                    <li>Git / GitHub</li>
                    <!-- Add your dev skills -->
                </ul>
            </div>

            <div class="skill-category">
                <h3>Tools & Platforms</h3>
                <ul class="skill-list">
                    <li>VS Code</li>
                    <li>Command Line</li>
                    <li>Netlify / Heroku</li>
                    <li>Database Management</li>
                    <!-- Add your tools -->
                </ul>
            </div>
        </section>

        <section class="experience-highlight">
            <h2>Professional Experience</h2>
            <p class="experience-intro">
                [Brief overview of your IT journey - mention key roles, companies, 
                or projects that showcase your capabilities]
            </p>
            
            <div class="linkedin-cta">
                <p>For my complete professional history and recommendations:</p>
                <a href="https://linkedin.com/in/YOUR-PROFILE" target="_blank" class="btn-linkedin">
                    View Full Profile on LinkedIn
                </a>
            </div>
        </section>

        <div class="cta-section">
            <p>Want to see my work in action?</p>
            <a href="/portfolio" class="btn-primary">View My Portfolio</a>
        </div>
    </article>
</BaseLayout>

<style>
    .what-i-can-do-page {
        /* Page-specific body class */
    }

    .skills-content {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 0;
    }

    h1 {
        font-size: 2.5rem;
        color: #1a1a1a;
        margin-bottom: 2rem;
        text-align: center;
    }

    .intro-section {
        margin-bottom: 3rem;
        padding: 2rem;
        background-color: #f0f7ff; /* Cool professional background */
        border-radius: 12px;
        border-left: 4px solid #0066cc; /* Professional blue accent */
        text-align: center;
    }

    .lead {
        font-size: 1.25rem;
        line-height: 1.8;
        color: #555;
        margin: 0;
    }

    /* Certifications Section */
    .certifications {
        margin-bottom: 4rem;
    }

    .certifications h2 {
        font-size: 2rem;
        color: #333;
        margin-bottom: 2rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #0066cc;
    }

    .cert-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .cert-card {
        background: white;
        border: 2px solid #e5e5e5;
        border-radius: 12px;
        padding: 2rem;
        text-align: center;
        transition: all 0.3s;
    }

    .cert-card:hover {
        border-color: #0066cc;
        transform: translateY(-4px);
        box-shadow: 0 4px 12px rgba(0, 102, 204, 0.1);
    }

    .cert-card.placeholder {
        border-style: dashed;
        opacity: 0.7;
    }

    .cert-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    .cert-card h3 {
        font-size: 1.3rem;
        color: #0066cc;
        margin-bottom: 0.5rem;
    }

    .cert-card p {
        color: #666;
        margin-bottom: 0.5rem;
    }

    .cert-details {
        font-size: 0.9rem;
        color: #999;
    }

    /* Skills Section */
    .skills {
        margin-bottom: 4rem;
    }

    .skills h2 {
        font-size: 2rem;
        color: #333;
        margin-bottom: 2rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #0066cc;
    }

    .skill-category {
        margin-bottom: 2rem;
        padding: 1.5rem;
        background-color: #f8f9fa;
        border-radius: 8px;
    }

    .skill-category h3 {
        font-size: 1.3rem;
        color: #0066cc;
        margin-bottom: 1rem;
    }

    .skill-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 0.75rem;
        list-style: none;
    }

    .skill-list li {
        padding: 0.5rem 1rem;
        background-color: white;
        border-radius: 6px;
        color: #555;
        font-weight: 500;
        border-left: 3px solid #0066cc;
    }

    /* Experience Section */
    .experience-highlight {
        margin-bottom: 3rem;
    }

    .experience-highlight h2 {
        font-size: 2rem;
        color: #333;
        margin-bottom: 2rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #0066cc;
    }

    .experience-intro {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #555;
        margin-bottom: 2rem;
    }

    .linkedin-cta {
        text-align: center;
        padding: 2rem;
        background-color: #f0f7ff;
        border-radius: 12px;
    }

    .linkedin-cta p {
        font-size: 1.1rem;
        color: #666;
        margin-bottom: 1rem;
    }

    .btn-linkedin {
        display: inline-block;
        padding: 1rem 2rem;
        background-color: #0077b5; /* LinkedIn blue */
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-linkedin:hover {
        background-color: #006399;
        transform: translateY(-2px);
    }

    /* CTA Section */
    .cta-section {
        text-align: center;
        padding: 3rem 2rem;
        background-color: #f8f9fa;
        border-radius: 12px;
    }

    .cta-section p {
        font-size: 1.2rem;
        color: #666;
        margin-bottom: 1.5rem;
    }

    .btn-primary {
        display: inline-block;
        padding: 1rem 2rem;
        background-color: #0066cc;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-primary:hover {
        background-color: #0052a3;
        transform: translateY(-2px);
    }
</style>