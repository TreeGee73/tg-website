---
// BaseLayout.astro - The foundation for all pages
const { pageTitle, pageClass = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{pageTitle} | Theresa Grier</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class={pageClass}>
    <header>
        <nav>
            <div class="logo">
                <a href="/">TG</a>
            </div>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/who-i-am">Who I Am</a></li>
                <li><a href="/what-i-can-do">What I Can Do</a></li>
                <li><a href="/portfolio">Portfolio</a></li>
                <li><a href="/contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <slot />
    </main>

    <footer>
        <div class="footer-content">
            <div class="social-links">
                <a href="https://www.linkedin.com/in/theresa-grier/" target="_blank" rel="noopener noreferrer">
                    LinkedIn
                </a>
                <a href="https://github.com/TreeGee73" target="_blank" rel="noopener noreferrer">
                    GitHub
                </a>
            </div>
            <p>&copy; {new Date().getFullYear()} Theresa Grier. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>

<style>
    /* Reset and base styles */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
        color: #333;
        background-color: #fff;
    }

    /* Header and Navigation */
    header {
        background-color: #fff;
        border-bottom: 1px solid #e5e5e5;
        position: sticky;
        top: 0;
        z-index: 100;
    }

    nav {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 2rem;
        display: flex;